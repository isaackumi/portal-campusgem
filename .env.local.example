# Copy to `.env.local` and fill in real values. Do not commit `.env.local`.

# App environment — developer SMS controls show when not production
ENVIRONMENT=development

# SMS — Hubtel (Ghana)
NEXT_PUBLIC_SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=CAMPUSGEM
# HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send
# SMS_BULK_GAP_MS=150

# Developer SMS controls
# SMS_FORCE_MOCK=true
# SMS_ALLOW_DRY_RUN=true

# Alternate: generic JSON SMS API
# NEXT_PUBLIC_SMS_PROVIDER=api
# SMS_API_URL=
# SMS_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CAMP_CONVEX_SERVER_SECRET=

# Email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_EMAIL_PROVIDER=mock
