# SMS — Hubtel (Ghana)
NEXT_PUBLIC_SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=CAMPUSGEM
# HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send
# Auto SMS after Camp Meeting registration (default: on for year >= 2026)
# CAMP_REGISTRATION_SMS_ENABLED=true
# CAMP_REGISTRATION_SMS_TEMPLATE=Hi {{firstName}}! You're registered for Camp {{campYear}}. Code: {{checkInCode}}
# CAMP_ROOM_SMS_TEMPLATE=Hi {{firstName}}! Your room is {{roomName}}{{buildingPart}}. Code: {{checkInCode}}.
# CAMP_SYSTEM_SENDER_ID=system-registration

# Birthday SMS (Hubtel) — daily cron at 07:00 UTC / Ghana
# CRON_SECRET=generate-a-long-random-string
# BIRTHDAY_SMS_AUTO_ENABLED=true
# BIRTHDAY_SMS_TEMPLATE=Happy Birthday {{firstName}}! Blessings from Campus Gem Ministries.
# BIRTHDAY_SYSTEM_SENDER_ID=system-birthday

# Alternate providers
# NEXT_PUBLIC_SMS_PROVIDER=api
# SMS_API_URL=
# SMS_API_KEY=
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username

ENVIRONMENT=development

# Convex — camp + core when NEXT_PUBLIC_CONVEX_URL is set
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CAMP_CONVEX_SERVER_SECRET=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
GOOGLE_ANALYTICS_ID=your_ga_id
SENTRY_DSN=your_sentry_dsn
