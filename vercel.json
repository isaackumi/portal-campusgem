{
  "buildCommand": "bash ci/vercel-build.sh",
  "installCommand": "bun install",
  "framework": "nextjs",
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NEXT_BUILD_TRACE": "0"
    }
  },
  "crons": [
    {
      "path": "/api/cron/birthday-sms",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/camp-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/pastoral-alerts",
      "schedule": "30 7 * * 1"
    },
    {
      "path": "/api/cron/activity-cleanup",
      "schedule": "0 3 1 * *"
    }
  ]
}
